<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- The machine-level NuGet config has no package sources, so restores fail with a
       misleading "unable to find version" error. Declaring the source here keeps the
       repo self-contained without changing anyone's global config. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
